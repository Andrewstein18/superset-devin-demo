# Remediation Engine — required environment variables
# Copy to .env and fill in your values.

# Devin API token (https://app.devin.ai → Settings → API)
DEVIN_API_TOKEN=

# GitHub personal access token with repo + issues scope
GITHUB_TOKEN=

# Target repository (owner/repo). Overrides config.yaml.
TARGET_REPO=Andrewstein18/superset-devin-demo

# Label that triggers the fixer workflow. Overrides config.yaml.
TRIGGER_LABEL=devin-fix
